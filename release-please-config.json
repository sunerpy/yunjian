{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "yunjian",
      "bump-minor-pre-major": true,
      "initial-version": "0.1.0",
      "include-v-in-tag": true,
      "draft": true,
      "force-tag-creation": true,
      "changelog-path": "changelog/CHANGELOG-v0.x.md",
      "changelog-sections": [
        { "type": "feat", "section": "新功能" },
        { "type": "feature", "section": "新功能" },
        { "type": "fix", "section": "缺陷修复" },
        { "type": "perf", "section": "性能优化" },
        { "type": "deps", "section": "依赖更新" },
        { "type": "revert", "section": "回滚" },
        { "type": "docs", "section": "文档", "hidden": true },
        { "type": "style", "section": "代码风格", "hidden": true },
        { "type": "refactor", "section": "重构", "hidden": true },
        { "type": "test", "section": "测试", "hidden": true },
        { "type": "build", "section": "构建", "hidden": true },
        { "type": "ci", "section": "持续集成", "hidden": true },
        { "type": "chore", "section": "杂项", "hidden": true }
      ],
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" }
      ]
    }
  }
}
